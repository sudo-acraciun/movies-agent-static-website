---
import PhoneFrame from './PhoneFrame.astro';
import type { Feature } from '../data/site';

// One paragraph and three bullets, no more. The eyebrow label these blocks
// used to carry was repeating the heading a line later, and the second
// paragraph was asking a phone reader to work through roughly 500 words of
// feature copy before reaching anything they could act on. The detail that
// was cut did not disappear from the page: it moved into the FAQ, which is
// where a reader who wants depth goes on purpose and where generative search
// looks first.
interface Props {
  feature: Feature;
  /** The capture for this block, imported in the page and matched by id. */
  screenshot: ImageMetadata;
  /** Even-indexed blocks put the art on the right, odd on the left. */
  flipped?: boolean;
}
const { feature, screenshot, flipped = false } = Astro.props;
---

{/*
  aria-labelledby is what turns this from a plain <section> into a landmark.
  An unnamed section is not exposed as a region at all, so before this the
  four feature blocks were invisible to landmark navigation and a screen
  reader user could only find them by hunting through the headings.

  tabindex="0" puts the section in the Tab order. Non-interactive containers
  are not usually focusable, and the objection to it is fair: a stop that
  does nothing is noise. This one is not nothing. Every one of these sections
  is a paragraph, three bullets and a screenshot with no control anywhere in
  it, so a keyboard-only visitor previously went from the hero button
  straight past all four of them into the FAQ. With a name attached, the stop
  announces "region, <heading>", which is the point of it.
*/}
<section
  class="feature section"
  id={feature.id}
  tabindex="0"
  aria-labelledby={`${feature.id}-title`}
>
  <div class:list={['wrap grid', { flipped }]}>
    <div class="copy">
      <h2 id={`${feature.id}-title`}>{feature.title}</h2>
      <p class="lede">{feature.body}</p>

      <ul class="points">
        {feature.bullets.map((bullet) => <li>{bullet}</li>)}
      </ul>

      {
        feature.link && (
          <p class="more">
            <a href={feature.link.href}>{feature.link.text}</a>
          </p>
        )
      }
    </div>

    <div class="art">
      <PhoneFrame src={screenshot} alt={feature.screenshotAlt} />
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: clamp(36px, 6vw, 72px);
    align-items: center;
  }

  .copy h2 {
    margin-bottom: 20px;
  }

  .art {
    display: flex;
    justify-content: center;
  }

  .points {
    list-style: none;
    padding: 0;
    margin: 26px 0 0;
    display: grid;
    gap: 14px;
  }

  .points li {
    position: relative;
    padding-left: 32px;
    color: var(--text);
    font-size: 1rem;
  }

  /* Checkmark drawn with a border rather than a glyph so it never falls back
     to a font that does not carry the character. */
  .points li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 8px;
    width: 11px;
    height: 6px;
    border-left: 2.5px solid var(--gold);
    border-bottom: 2.5px solid var(--gold);
    transform: rotate(-45deg);
  }

  /* A quiet text link, deliberately not a second CTA: the section's job is
     still the app, this is a side door for the reader who wants the content
     first. */
  .more {
    margin: 18px 0 0;
    font-size: 0.95rem;
  }

  .more a {
    color: var(--link);
    text-underline-offset: 3px;
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }

    .grid.flipped .copy {
      order: 2;
    }

    .grid.flipped .art {
      order: 1;
    }
  }
</style>
