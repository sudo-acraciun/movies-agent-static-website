---
import ArticleLayout from '../layouts/ArticleLayout.astro';
import { SITE } from '../data/site';
import { WEEKLY_THEMES, formatWeek, type WeeklyTheme } from '../data/themes';
import StoreButtons from './StoreButtons.astro';
import PosterCardStyles from './PosterCardStyles.astro';

interface Props {
  theme: WeeklyTheme;
}

const { theme: t } = Astro.props;
const path = `/themes/${t.slug}`;

// WEEKLY_THEMES is newest first, so the chronological neighbours sit at
// index+1 (the week before) and index-1 (the week after).
const index = WEEKLY_THEMES.findIndex((o) => o.slug === t.slug);
const earlier = WEEKLY_THEMES[index + 1];
const later = index > 0 ? WEEKLY_THEMES[index - 1] : undefined;

// Article + FAQPage as everywhere, plus ItemList mirroring the visible list
// exactly: same order, same titles. Curated order is not a ranking, so no
// itemListOrder claim, same as the unranked /list pages.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: t.h1,
    description: t.metaDescription,
    author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    mainEntityOfPage: new URL(path, SITE.url).href,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: t.h1,
    numberOfItems: t.items.length,
    itemListElement: t.items.map((item, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `${item.title} (${item.year})`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: t.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a.join(' ') },
    })),
  },
];
---

<ArticleLayout
  title={t.title}
  description={t.metaDescription}
  path={path}
  heading={t.h1}
  jsonLd={jsonLd}
  disclosure={false}
  heroImage={t.heroBackdropUrl}
  heroPosition={t.heroPosition}
>
  <PosterCardStyles />
  <p class="theme-week">Weekly collection in the app for the week of {formatWeek(t.weekOf)}.</p>

  {t.intro.map((paragraph) => <p>{paragraph}</p>)}

  <h2>The collection</h2>
  <ol class="poster-grid">
    {
      t.items.map((item, i) => (
        <li class="poster-card">
          <div class="poster-wrap">
            {i === 0 && <span class="featured-badge">Featured</span>}
            {item.posterPath ? (
              <img class="poster" src={item.posterPath} alt={`${item.title} poster`} width="342" height="513" loading="lazy" />
            ) : (
              <div class="poster-fallback">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M4 4h16v16H4z M4 9h16 M4 15h16 M9 4v16 M15 4v16" stroke="currentColor" stroke-width="1.5" />
                </svg>
              </div>
            )}
          </div>
          <div class="card-info">
            <span class="card-title">{item.title}</span>
            <span class="card-year">{item.year}</span>
            {item.imdbRating != null && (
              <span class="card-meta">
                <span class="imdb">
                  <span class="imdb-badge">IMDb</span>
                  {item.imdbRating.toFixed(1)}
                </span>
              </span>
            )}
            <span class="card-caption">
              <span class="card-director">{item.director}</span>
              <span class="card-blurb">{item.blurb}</span>
              {item.cast && <span class="card-cast">Cast: {item.cast}</span>}
            </span>
          </div>
        </li>
      ))
    }
  </ol>

  <h2>Keep your place</h2>
  <p>{t.appNote}</p>

  <h2>Questions people ask</h2>
  {
    t.faqs.map((faq) => (
      <details>
        <summary>{faq.q}</summary>
        {faq.a.map((paragraph) => <p>{paragraph}</p>)}
      </details>
    ))
  }

  {/* Same inline-join shape as WatchOrderPage's other-orders line, but themes
      chain chronologically, so the neighbours come first. */}
  <p class="other-lists">
    {earlier && (
      <span>
        The week before: <a href={`/themes/${earlier.slug}`}>{earlier.h1}</a>.{' '}
      </span>
    )}
    {later && (
      <span>
        The week after: <a href={`/themes/${later.slug}`}>{later.h1}</a>.{' '}
      </span>
    )}
    See <a href="/themes">every weekly theme</a>, or browse{' '}
    <a href="/guides">every guide, watch order and comparison</a>.
  </p>

  <div class="cta-row">
    <StoreButtons />
    <a href="/">More about the app</a>
  </div>
</ArticleLayout>

<style is:global>
  .article .theme-week {
    color: var(--text-secondary);
    font-size: 0.92rem;
  }

  /* Featured marker over the first film's poster (the film that fronted the
     week in the app): a gold-outlined pill, top-left, the same gold as the
     IMDb badge. */
  .article .featured-badge {
    position: absolute;
    top: 6px;
    left: 6px;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.72);
    border: 1px solid rgba(245, 197, 24, 0.7);
    color: var(--gold);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  /* Director surname above the blurb, muted, as it read in the old list. */
  .article .card-director {
    display: block;
    color: var(--text-secondary);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .article .card-blurb {
    display: block;
    margin-top: 3px;
  }

  /* Quieter than the blurb: supporting fact, not the pitch. */
  .article .card-cast {
    display: block;
    margin-top: 4px;
    font-size: 0.82rem;
    opacity: 0.8;
  }

  .article .other-lists {
    margin-top: 2rem;
  }
</style>
