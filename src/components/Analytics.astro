---
// Website traffic analytics, and the one place this otherwise-static site
// loads client JS. It measures three things only: page visits, traffic source
// (referrer), and clicks on the Google Play link.
//
// The project key is public: it ships to every visitor's browser, exactly like
// a Sentry DSN, so it lives here as a plain constant rather than a build
// secret. It is empty until the PostHog EU project exists; while empty the
// script initialises nothing, so this component is safe to ship early.
---

<script>
  const KEY = '';
  const HOST = 'https://eu.i.posthog.com';

  // import.meta.env.PROD is a Vite build-time constant: false under `astro dev`,
  // true under `astro build` / `astro preview`, so local development never
  // emits events. posthog-js is loaded with a dynamic import so its payload is
  // fetched only when a key is present in a production build: never in dev, and
  // never during the interim before the PostHog project key is filled in.
  if (import.meta.env.PROD && KEY) {
    import('posthog-js')
      .then(({ default: posthog }) => {
        posthog.init(KEY, {
          api_host: HOST,
          autocapture: false,
          capture_pageview: true,
          // No cookies, so no consent banner is required. The cost is that a
          // returning visitor counts as new each day; visits, sources and the
          // Play click are all still recorded. person_profiles is left at its
          // default (identified_only): cookieless events stay anonymous, so no
          // profile is ever created regardless.
          cookieless_mode: 'always',
        });

        // Google Play links are matched by href, not class: the header ("Get
        // the app") and footer ("Google Play") links do not carry the
        // .badge-play class that the store badges do. closest('a') also handles
        // a click that lands on the badge's inner icon or text.
        const onActivate = (event: Event) => {
          if (!(event.target instanceof Element)) return;
          // Only a left (0) or middle (1) click opens the store. auxclick fires
          // for every non-primary button, so drop right-clicks (2) and the
          // back/forward mouse buttons — a right-click opens a menu, not the app.
          if (event instanceof MouseEvent && event.button > 1) return;
          const link = event.target.closest('a');
          if (link && link.href.startsWith('https://play.google.com/store')) {
            posthog.capture('google_play_click', {
              // Collapse the badge's inter-element whitespace so the property
              // reads "Get it on Google Play", not a newline-broken string.
              text: link.textContent?.replace(/\s+/g, ' ').trim(),
              path: location.pathname,
            });
          }
        };
        // click for a left/keyboard activation, auxclick for a middle-click
        // that opens the store in a new tab.
        document.addEventListener('click', onActivate);
        document.addEventListener('auxclick', onActivate);
      })
      .catch(() => {
        // Analytics is additive. A load or init failure (blocked script,
        // network error) must never take the page down with it.
      });
  }
</script>
