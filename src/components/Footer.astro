---
import Logo from './Logo.astro';
import { SITE } from '../data/site';

// Runs in frontmatter, so this executes once, at `astro build`, on the build
// machine's clock, not per request in a browser. The site is static with zero
// client JS, so this stamps whatever year the site was last built in rather
// than ticking over live; a redeploy in January is what rolls it forward.
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap inner">
    <div class="about">
      <a class="brand" href="/">
        <Logo size={30} />
        <span>I Like Movies</span>
      </a>
      {/*
        A plain descriptor, nothing else.

        What used to be here named the developer and the country, then
        repeated "free, no ads" for the third time on one page. The operator
        country still reaches the readers that use it: addressCountry sits in
        the WebSite JSON-LD and llms.txt states it outright. Saying it in the
        footer added nothing a parser reads, and "built by one developer"
        reads as a risk to someone deciding whether to move years of viewing
        history into an app.
      */}
      <p>
        Track what you watch, decide what to watch next, and share one library
        with the people you live with.
      </p>
    </div>

    <nav aria-label="Footer">
      <div class="col">
        {/* "App" labelled a column of page anchors, which is not what an app
            is. These are places on this page plus the store link. */}
        <h3>Explore</h3>
        {/* Root-relative, not bare fragments: this footer is shared with the
            legal pages, where "#faq" would resolve against /privacy. */}
        <a href="/#discover">Features</a>
        <a href="/#switch">Switching apps</a>
        <a href="/#faq">FAQ</a>
        <a href="/changelog">Changelog</a>
        <a href={SITE.playUrl} target="_blank" rel="noopener">Google Play</a>
      </div>

      <div class="col">
        {/* No target="_blank" since these moved onto this domain. Forcing a
            new tab is for leaving the site, and a legal page the reader can
            back out of is the better behaviour now that it is one of ours. */}
        <h3>Legal</h3>
        <a href={SITE.legal.privacy}>Privacy policy</a>
        <a href={SITE.legal.terms}>Terms of use</a>
        <a href={SITE.legal.deleteAccount}>Delete your account</a>
      </div>

      <div class="col">
        <h3>Contact</h3>
        <a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a>
      </div>
    </nav>
  </div>

  <div class="wrap bottom">
    <p>&copy; {year} I Like Movies. Film and TV metadata provided by TMDB.</p>
    {/*
      TMDB's terms require an explicit statement that the product is not
      endorsed or certified by them wherever their data is used. The site
      describes an app built on that data, so the attribution belongs here.
    */}
    <p>This product uses the TMDB API but is not endorsed or certified by TMDB.</p>
    {/*
      Launch Llama's crawler verifies this exact anchor href and image src on
      the live homepage to activate our directory listing, so the snippet stays
      verbatim from their embed code. Removing or rewriting it un-verifies the
      listing.
    */}
    <a
      class="launchllama-badge"
      href="https://tools.launchllama.co?utm_source=badge&utm_medium=referral"
      target="_blank"
      rel="noopener noreferrer"
    >
      <img
        src="https://tools.launchllama.co/featured-badge.png?v=2"
        alt="As seen on Launch Llama Newsletter"
        width="200"
        height="50"
        loading="lazy"
      />
    </a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--ink-border);
    background: #080b11;
    padding: clamp(48px, 7vw, 76px) 0 40px;
    color: var(--text-secondary);
    font-size: 0.94rem;
  }

  .inner {
    display: grid;
    gap: 44px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text);
    font-weight: 800;
    letter-spacing: -0.02em;
    font-size: 1.05rem;
    margin-bottom: 14px;
  }

  .about p {
    max-width: 42ch;
  }

  nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 32px;
  }

  /* h3, not h2. These are labels for three link groups, not page sections.
     As h2 they sat at the same level as the real content sections and made
     "App", "Legal" and "Contact" look like major topics in the outline.
     Kept as headings rather than plain spans because screen reader users
     navigate footers by heading. */
  .col h3 {
    font-size: 0.76rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 14px;
    font-weight: 700;
  }

  .col a {
    display: block;
    text-decoration: none;
    padding: 5px 0;
    transition: color 0.15s ease;
    overflow-wrap: anywhere;
  }

  .col a:hover {
    color: var(--gold);
  }

  .bottom {
    margin-top: 44px;
    padding-top: 26px;
    border-top: 1px solid rgba(37, 45, 61, 0.6);
    font-size: 0.84rem;
    color: var(--text-muted);
  }

  .bottom p {
    margin: 0 0 6px;
  }

  /* Shrunk and dimmed via CSS only: the anchor/img markup must stay verbatim
     for Launch Llama's badge verification, so sizing never moves into the
     width/height attributes. */
  .launchllama-badge {
    display: inline-block;
    margin-top: 14px;
    opacity: 0.45;
    transition: opacity 0.15s ease;
  }

  .launchllama-badge:hover {
    opacity: 1;
  }

  .launchllama-badge img {
    display: block;
    width: 132px;
    height: 33px;
  }

  /* There was a .fine rule here, opacity 0.75 on the TMDB notice, which put
     it at 2.8:1 and made the one line on the page we are contractually
     obliged to publish the least readable thing on it. Both paragraphs now
     take --text-muted from .bottom, which is quiet enough on its own. */

  @media (min-width: 880px) {
    .inner {
      grid-template-columns: 1.1fr 1.4fr;
      gap: 60px;
    }
  }
</style>
