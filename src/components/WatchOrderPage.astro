---
import ArticleLayout from '../layouts/ArticleLayout.astro';
import { SITE } from '../data/site';
import { WATCH_ORDERS, type WatchOrder } from '../data/watchOrders';
import StoreButtons from './StoreButtons.astro';
import PosterCardStyles from './PosterCardStyles.astro';

interface Props {
  order: WatchOrder;
}

const { order: o } = Astro.props;
const path = `/${o.slug}`;

// Cross-links: the other watch-order pages, linked directly because a reader
// mid-franchise wants the sibling list in one click, not a trip through the
// /guides hub the footer links.
const others = WATCH_ORDERS.filter((w) => w.slug !== o.slug);

// Article + FAQPage as on the /vs pages, plus ItemList for the primary
// (first) order, which is the list this page exists to answer with.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: o.h1,
    description: o.metaDescription,
    author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    mainEntityOfPage: new URL(path, SITE.url).href,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `${o.franchise} watch order`,
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    numberOfItems: o.sections[0].items.length,
    itemListElement: o.sections[0].items.map((item, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `${item.title} (${item.year})`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: o.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a.join(' ') },
    })),
  },
];

const KIND_LABEL = { film: 'Film', series: 'Series', special: 'Special' } as const;
---

<ArticleLayout
  title={o.title}
  description={o.metaDescription}
  path={path}
  heading={o.h1}
  jsonLd={jsonLd}
  disclosure={false}
  heroImage={o.heroBackdrop}
  heroPosition={o.heroPosition}
>
  <PosterCardStyles />
  {o.intro.map((paragraph) => <p>{paragraph}</p>)}

  {
    o.sections.map((section) => (
      <>
        <h2>{section.heading}</h2>
        <p>{section.blurb}</p>
        <ol class="poster-grid">
          {section.items.map((item) => (
            <li class="poster-card">
              <div class="poster-wrap">
                {item.kind !== 'film' && <span class="poster-badge">{KIND_LABEL[item.kind]}</span>}
                {item.posterPath ? (
                  <img class="poster" src={item.posterPath} alt={`${item.title} poster`} width="342" height="513" loading="lazy" />
                ) : (
                  <div class="poster-fallback">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M4 4h16v16H4z M4 9h16 M4 15h16 M9 4v16 M15 4v16" stroke="currentColor" stroke-width="1.5" />
                    </svg>
                  </div>
                )}
              </div>
              <div class="card-info">
                <span class="card-title">{item.title}</span>
                <span class="card-year">{item.year}</span>
                {item.note && <span class="card-caption">{item.note}</span>}
              </div>
            </li>
          ))}
        </ol>
      </>
    ))
  }

  <h2>Keep your place</h2>
  {
    o.hasAppTrack ? (
      <p>
        I Like Movies, the free iPhone and Android app behind this page, carries a curated{' '}
        {o.franchise} track: the same catalogue as above, in watch order, with
        your progress marked per film and per episode. Ratings and a watchlist
        come along for everything else you watch.
      </p>
    ) : (
      <p>
        I Like Movies, the free iPhone and Android app behind this page, keeps your place
        in any franchise: mark films and episodes watched, rate them, and keep
        a watchlist for what is next.
      </p>
    )
  }

  <h2>Questions people ask</h2>
  {
    o.faqs.map((faq) => (
      <details>
        <summary>{faq.q}</summary>
        {faq.a.map((paragraph) => <p>{paragraph}</p>)}
      </details>
    ))
  }

  {/* set:text-free inline join: Astro emits whitespace between sibling
      expressions, which rendered as " , " between links. Comma lives inside
      the same expression as the anchor to keep them glued. */}
  <p class="other-orders">
    More watch orders: {others.map((w, i) => (
      <span>{i > 0 && ', '}<a href={`/${w.slug}`}>{w.franchise}</a></span>
    ))}. Or browse <a href="/guides">every guide and comparison</a>.
  </p>

  <div class="cta-row">
    <StoreButtons />
    <a href="/">More about the app</a>
  </div>
</ArticleLayout>

<style is:global>
  /* Only watch-order pages render an .other-orders line; the poster grid and
     card styles are shared (PosterCardStyles). */
  .article .other-orders {
    margin-top: 2rem;
  }
</style>
