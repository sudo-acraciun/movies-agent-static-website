---
import { SITE } from '../data/site';

// Store buttons render from SITE.appStoreUrl being null or a string. When the
// iOS listing goes live, setting that one constant turns the disabled badge
// into a real link everywhere it appears. There is deliberately no way to
// render an iOS link while the URL is null: a store button that 404s reads as
// a broken product, and "coming soon" costs nothing to say honestly.
interface Props {
  size?: 'default' | 'large';
  align?: 'left' | 'center';
}
const { size = 'default', align = 'left' } = Astro.props;
const iosLive = SITE.appStoreUrl !== null;

// The "coming soon" span carried an aria-label as well, and on a <span> it
// was doing nothing at all: aria-label is ignored on an element with no
// role. Its visible text already says "Coming soon to iPhone".
//
// Note on comment placement, which cost two builds to learn: a {/* */}
// expression comment inside a branch of the ternary below is a parse error
// ("Expected corresponding JSX closing tag for 'Fragment'"). Notes about the
// ternary belong up here.
---

<div class:list={['store-buttons', size, align]}>
  {/*
    No aria-label on either badge, deliberately.

    They both carried one, and it read "Download I Like Movies on Google
    Play" while the visible text said "Get it on Google Play". An aria-label
    REPLACES the accessible name rather than adding to it, so the name no
    longer contained the words on screen. That fails WCAG 2.5.3 Label in
    Name, and the practical cost is real: a voice-control user saying "click
    Get it on Google Play" gets no match, because the words they can see are
    not the words the browser is matching against.

    Removing it leaves the name as the inner text, which is correct, which is
    what the official store badges themselves say, and which needs no
    maintenance when the brand name changes.
  */}
  <a class="badge badge-play" href={SITE.playUrl} rel="noopener">
    <svg viewBox="0 0 24 24" aria-hidden="true" class="badge-icon">
      <path
        d="M3.6 2.3a1.3 1.3 0 0 0-.5 1v17.4c0 .4.2.8.5 1l9.2-9.7L3.6 2.3Z"
        fill="#00D4FF"></path>
      <path d="M16.6 8.6 5.3 2.1 4.9 1.9a1.2 1.2 0 0 0-1.3.4l9.2 9.7 3.8-3.4Z" fill="#00F076"></path>
      <path d="M20.6 11 17 9l-4 3 4 3 3.6-2a1.2 1.2 0 0 0 0-2.1Z" fill="#FFC900"></path>
      <path d="M3.6 22.1c.35.3.86.35 1.3.1l11.7-6.7-3.8-3.4-9.2 10Z" fill="#FF3A44"></path>
    </svg>
    <span class="badge-text">
      <small>Get it on</small>
      <strong>Google Play</strong>
    </span>
  </a>

  {
    iosLive ? (
      <a class="badge badge-apple" href={SITE.appStoreUrl!} rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true" class="badge-icon">
          <path
            d="M16.4 12.7c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.15-2.8.85-3.5.85-.7 0-1.85-.83-3-.81-1.55.02-3 .9-3.8 2.3-1.6 2.8-.4 7 1.15 9.3.77 1.13 1.68 2.4 2.87 2.35 1.15-.05 1.58-.74 2.97-.74 1.38 0 1.78.74 3 .72 1.24-.02 2.02-1.14 2.78-2.28.88-1.3 1.24-2.57 1.26-2.64-.03-.01-2.4-.92-2.43-3.65ZM14.1 5.6c.62-.76 1.04-1.8.93-2.85-.9.04-2 .6-2.64 1.35-.57.67-1.07 1.74-.94 2.76 1 .08 2.02-.5 2.65-1.26Z"
            fill="currentColor"
          />
        </svg>
        <span class="badge-text">
          <small>Download on the</small>
          <strong>App Store</strong>
        </span>
      </a>
    ) : (
      <span class="badge badge-soon">
        <svg viewBox="0 0 24 24" aria-hidden="true" class="badge-icon">
          <path
            d="M16.4 12.7c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.15-2.8.85-3.5.85-.7 0-1.85-.83-3-.81-1.55.02-3 .9-3.8 2.3-1.6 2.8-.4 7 1.15 9.3.77 1.13 1.68 2.4 2.87 2.35 1.15-.05 1.58-.74 2.97-.74 1.38 0 1.78.74 3 .72 1.24-.02 2.02-1.14 2.78-2.28.88-1.3 1.24-2.57 1.26-2.64-.03-.01-2.4-.92-2.43-3.65ZM14.1 5.6c.62-.76 1.04-1.8.93-2.85-.9.04-2 .6-2.64 1.35-.57.67-1.07 1.74-.94 2.76 1 .08 2.02-.5 2.65-1.26Z"
            fill="currentColor"
          />
        </svg>
        <span class="badge-text">
          <small>Coming soon to</small>
          <strong>iPhone</strong>
        </span>
      </span>
    )
  }
</div>

<style>
  .store-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .store-buttons.center {
    justify-content: center;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 12px 22px 12px 18px;
    /* The two label lines are sized in em from here, so one font-size on the
       badge scales both. 1.05rem reproduces exactly what the two lines were
       set to before. */
    font-size: 1.05rem;
    border-radius: 14px;
    text-decoration: none;
    border: 1px solid var(--ink-border);
    background: #000;
    color: #fff;
    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      box-shadow 0.18s ease;
  }

  .badge-play:hover,
  .badge-apple:hover {
    transform: translateY(-2px);
    border-color: rgba(245, 197, 24, 0.55);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
  }

  .badge-icon {
    width: 26px;
    height: 26px;
    flex: none;
  }

  .badge-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    text-align: left;
  }

  .badge-text small {
    font-size: 0.648em;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
  }

  .badge-text strong {
    font-size: 1em;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  /* The unavailable state has to LOOK unavailable. Same silhouette so the
     layout does not shift when iOS goes live, but muted, no hover lift, and
     default cursor so it never reads as a dead link.

     This was opacity: 0.5, which is the easy way to say "unavailable" and
     took the small line down to 2.7:1 against the background. Dimming text
     past the point of legibility is not a style choice, it is a decision
     that people with low vision cannot read this badge at all, and the badge
     is carrying the only statement on the page that iOS is coming.

     Dashed border plus muted colours says the same thing and stays readable:
     the strong line sits at 7.6:1 and the small one at 5.5:1. currentColor
     also carries down into the Apple glyph, so it mutes with the text
     instead of staying bright white next to it. */
  .badge-soon {
    cursor: default;
    background: transparent;
    border-style: dashed;
    color: var(--text-secondary);
  }

  .badge-soon .badge-text small {
    color: var(--text-muted);
  }

  /*
    The large pair has to sit on ONE line on a phone, and at its full size it
    cannot. Measured in a real browser: the Play badge is 186.7px, the iPhone
    badge 177.3px, plus the 14px gap, so the row needs 378px. The wrap gives
    it the viewport minus 48px of page padding, which only reaches 378px at a
    426px viewport. Every phone in use is narrower than that (the capture that
    prompted this was a 412px device), so every phone wrapped the iPhone badge
    onto its own line.

    Of that 378px, the text runs are 176px and everything around them, the
    padding, the icons, the two gaps and the borders, is 202px. So closing the
    66px shortfall at a 360px viewport with type alone would mean cutting the
    text to 110px, which is 10.5px type on the page's primary call to action.
    The room is in the other 202px, so that is what shrinks hard (padding
    22/28 to 12/15, icon 30 to 24) while the type gives up a tenth of its size
    and stays readable.

    Both ends are anchored to measurements, not taste: at a 360px viewport
    the row comes to 292px against 312px available, and 480px is where the
    full-size row has comfortable room again, so above it nothing changes at
    all. Between them every value rides the same linear ramp, which is what
    the negative pixel terms in the calc()s are: the y-intercept of a line
    through (360px, min) and (480px, max).

    Below 360px the values floor and the row wraps again, which is correct
    rather than a gap: fitting a 320px screen means type under 14px on the
    page's primary call to action, and a wrapped pair reads better than an
    illegible one.
  */
  .store-buttons.large {
    gap: clamp(10px, calc(-2px + 3.334vw), 14px);
  }

  .large .badge {
    font-size: clamp(0.95rem, calc(10.4px + 1.334vw), 1.05rem);
    gap: clamp(8px, calc(-4px + 3.334vw), 12px);
    padding: clamp(13px, calc(7px + 1.667vw), 15px) clamp(15px, calc(-24px + 10.834vw), 28px)
      clamp(13px, calc(7px + 1.667vw), 15px) clamp(12px, calc(-18px + 8.334vw), 22px);
  }

  .large .badge-icon {
    width: clamp(24px, calc(6px + 5vw), 30px);
    height: clamp(24px, calc(6px + 5vw), 30px);
  }
</style>
