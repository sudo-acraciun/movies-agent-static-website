---
import ArticleLayout from '../layouts/ArticleLayout.astro';
import { SITE } from '../data/site';
import { LISTICLES, type Listicle } from '../data/listicles';
import StoreButtons from './StoreButtons.astro';
import PosterCardStyles from './PosterCardStyles.astro';

interface Props {
  list: Listicle;
}

const { list: l } = Astro.props;
const path = `/list/${l.slug}`;

// Cross-links: the other listicles, linked directly like the watch-order
// pages link each other; the /guides hub covers the cross-type paths.
const others = LISTICLES.filter((o) => o.slug !== l.slug);

// Sort controls are progressive enhancement: the HTML ships in the default
// (score) order, which is what crawlers and the ItemList schema see, and the
// buttons only re-order the DOM client-side. They render only when every
// item carries a score, so a scoreless list stays a plain static list.
const sortable = l.items.every((item) => item.tmdbScore != null);

// Article + FAQPage as everywhere, plus ItemList mirroring the visible list
// exactly: same order, same titles. itemListOrder only claims an ordering
// when the page actually ranks.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: l.h1,
    description: l.metaDescription,
    author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    mainEntityOfPage: new URL(path, SITE.url).href,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: l.h1,
    ...(l.ranked ? { itemListOrder: 'https://schema.org/ItemListOrderAscending' } : {}),
    numberOfItems: l.items.length,
    itemListElement: l.items.map((item, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `${item.title} (${item.year})`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: l.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a.join(' ') },
    })),
  },
];
---

<ArticleLayout
  title={l.title}
  description={l.metaDescription}
  path={path}
  heading={l.h1}
  jsonLd={jsonLd}
  disclosure={false}
  heroImage={l.heroBackdrop}
  heroPosition={l.heroPosition}
>
  <PosterCardStyles />
  {l.intro.map((paragraph) => <p>{paragraph}</p>)}

  <div class="list-head">
    <h2>{l.listHeading}</h2>
    {
      sortable && (
        <div class="rank-controls" role="group" aria-label="Sort the list">
          <button type="button" data-sort="score" aria-pressed="true">By score</button>
          <button type="button" data-sort="newest" aria-pressed="false">Newest first</button>
          <button type="button" data-sort="oldest" aria-pressed="false">Oldest first</button>
        </div>
      )
    }
  </div>

  {
    l.ranked ? (
      <ol class="poster-grid">
        {l.items.map((item, i) => (
          <li class="poster-card" data-score={item.tmdbScore} data-year={item.year} data-rank={i + 1}>
            <div class="poster-wrap">
              <span class="rank-badge">{i + 1}</span>
              {item.posterPath ? (
                <img class="poster" src={item.posterPath} alt={`${item.title} poster`} width="342" height="513" loading="lazy" />
              ) : (
                <div class="poster-fallback">
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M4 4h16v16H4z M4 9h16 M4 15h16 M9 4v16 M15 4v16" stroke="currentColor" stroke-width="1.5" />
                  </svg>
                </div>
              )}
            </div>
            <div class="card-info">
              <span class="card-title">{item.title}</span>
              <span class="card-year">{item.year}</span>
              <span class="card-meta">
                {item.tmdbScore != null && <span class="score-chip">★ {item.tmdbScore.toFixed(1)}</span>}
                {item.runtimeMin != null && <span class="runtime-chip">{item.runtimeMin} min</span>}
              </span>
              <span class="card-caption">{item.blurb}</span>
            </div>
          </li>
        ))}
      </ol>
    ) : (
      <ul class="poster-grid">
        {l.items.map((item) => (
          <li class="poster-card" data-score={item.tmdbScore} data-year={item.year}>
            <div class="poster-wrap">
              {item.posterPath ? (
                <img class="poster" src={item.posterPath} alt={`${item.title} poster`} width="342" height="513" loading="lazy" />
              ) : (
                <div class="poster-fallback">
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M4 4h16v16H4z M4 9h16 M4 15h16 M9 4v16 M15 4v16" stroke="currentColor" stroke-width="1.5" />
                  </svg>
                </div>
              )}
            </div>
            <div class="card-info">
              <span class="card-title">{item.title}</span>
              <span class="card-year">{item.year}</span>
              <span class="card-meta">
                {item.tmdbScore != null && <span class="score-chip">★ {item.tmdbScore.toFixed(1)}</span>}
                {item.runtimeMin != null && <span class="runtime-chip">{item.runtimeMin} min</span>}
              </span>
              <span class="card-caption">{item.blurb}</span>
            </div>
          </li>
        ))}
      </ul>
    )
  }

  <h2>Keep your place</h2>
  <p>{l.appNote}</p>

  <h2>Questions people ask</h2>
  {
    l.faqs.map((faq) => (
      <details>
        <summary>{faq.q}</summary>
        {faq.a.map((paragraph) => <p>{paragraph}</p>)}
      </details>
    ))
  }

  {/* A list, not a comma-run sentence, same shape as the /best pages' "More
      roundups" block: list titles are long, so the inline form is unreadable
      past two entries. Renders only when another list exists. */}
  {others.length > 0 && (
    <>
      <p class="more-lists-label">More lists</p>
      <ul class="more-lists">
        {others.map((o) => (
          <li>
            <a href={`/list/${o.slug}`}>{o.h1}</a>
          </li>
        ))}
      </ul>
    </>
  )}
  <p>
    {l.related && (
      <span>
        Related: <a href={l.related.href}>{l.related.label}</a>.{' '}
      </span>
    )}
    Or browse <a href="/guides">every guide, watch order and comparison</a>.
  </p>

  <div class="cta-row">
    <StoreButtons />
    <a href="/">More about the app</a>
  </div>
</ArticleLayout>

<style is:global>
  /* Score chip in the card meta: the score is the data this page ranks on, so
     it reads at full gold strength, same chip as the reference page. */
  .article .poster-card .score-chip {
    display: inline-block;
    padding: 1px 8px;
    border: 1px solid rgba(245, 197, 24, 0.35);
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--gold);
  }

  /* Runtime chip: same shape, quieter, because the score leads and the length
     supports (only the under-100-minutes list carries it). */
  .article .poster-card .runtime-chip {
    display: inline-block;
    padding: 1px 8px;
    border: 1px solid var(--ink-border);
    border-radius: 999px;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
  }

  .article .more-lists-label {
    margin: 34px 0 8px;
    font-weight: 700;
    color: var(--text);
  }

  .article ul.more-lists {
    margin-bottom: 1rem;
  }

  /* Heading and sort buttons share one row, buttons pushed to the right;
     on a narrow screen the buttons wrap under the heading. The h2's global
     margin moves onto this wrapper so the row spaces like any other h2. */
  .article .list-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 18px;
    /* 1.5rem below, the same gap the list itself leaves before the next
       block, so the head-row spacing matches the page rhythm. */
    margin: 46px 0 1.5rem;
  }

  .article .list-head h2 {
    margin: 0;
  }

  .article .rank-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .article .rank-controls button {
    font: inherit;
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.15;
    color: var(--text-secondary);
    background: var(--ink-raised);
    border: 1px solid var(--ink-border);
    border-radius: 999px;
    padding: 8px 16px;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .article .rank-controls button:hover {
    color: var(--text);
  }

  .article .rank-controls button[aria-pressed='true'] {
    color: var(--ink);
    background: var(--gold);
    border-color: var(--gold);
  }
</style>

<script>
  // Progressive enhancement only: re-orders the already-rendered <li>s. The
  // shipped HTML order (score) is what no-JS readers, crawlers and the
  // ItemList schema all see; data-rank preserves the original position so
  // "By score" restores it exactly.
  document.querySelectorAll('.rank-controls').forEach((controls) => {
    // The controls sit inside .list-head; the list is its sibling, so scope
    // the lookup to the shared article container rather than the parent.
    const list = controls.closest('.wrap')?.querySelector('.poster-grid');
    if (!list) return;

    const sorters: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
      score: (a, b) => Number(a.dataset.rank) - Number(b.dataset.rank),
      newest: (a, b) => Number(b.dataset.year) - Number(a.dataset.year),
      oldest: (a, b) => Number(a.dataset.year) - Number(b.dataset.year),
    };

    controls.querySelectorAll<HTMLButtonElement>('button[data-sort]').forEach((button) => {
      button.addEventListener('click', () => {
        const sorter = sorters[button.dataset.sort ?? ''];
        if (!sorter) return;
        const items = [...list.querySelectorAll<HTMLElement>(':scope > li')];
        items.sort(sorter).forEach((item) => list.appendChild(item));
        controls
          .querySelectorAll('button[data-sort]')
          .forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
      });
    });
  });
</script>
