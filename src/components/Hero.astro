---
import StoreButtons from './StoreButtons.astro';
import PhoneFrame from './PhoneFrame.astro';
import { SITE } from '../data/site';

// Real captures are imported from src/assets so astro:assets can process
// them. Anything left in public/ is still a placeholder.
import movieDetailShot from '../assets/screenshots/movie-detail.png';
import libraryShot from '../assets/screenshots/library.png';

// Screen choice matters here. The hero deliberately shows the library and a
// film detail page, neither of which appears in any section below it, so the
// first thing a visitor scrolls into is new rather than a repeat of the hero.
// They are also the two most poster-dense screens in the app, which is what
// makes a movie app read as a movie app at a glance.
---

<section class="hero">
  <div class="glow" aria-hidden="true"></div>

  <div class="wrap grid">
    <div class="copy">
      {/*
        Brand eyebrow. Search Console now shows the brand name has real volume
        ("i like movies app" ranks pos 2 and drives nearly all clicks), so the
        entity token earns a place above the tagline H1. Kept to the name only:
        the definitional sentence below still carries "free", "for Android" and
        the differentiators, so this is the brand token the H1 lacked, not a
        return of the three-fact eyebrow that was cut as redundant.
      */}
      <p class="eyebrow">I Like Movies</p>
      <h1>
        Everything you have watched.<br />
        <span class="accent">Everything you are going to.</span>
      </h1>

      {/*
        Job-to-be-done kicker, added under the H1 rather than replacing the
        brand eyebrow above it: the eyebrow keeps its brand token, and the
        definition sentence below keeps its place directly under the heading.
        Query-shaped for the discovery search the brand name is invisible for
        ("decide what to watch"); no "AI", by the same rule the H1 follows.
      */}
      <p class="job">The movie and TV tracker that helps you decide what to watch.</p>

      {/*
        The definitional sentence. Sits directly below the job kicker and is
        still the first body paragraph after the heading; duplicated as the
        meta description, unchanged in both places. Generative search engines
        lift this sentence shape verbatim when asked what the product is, so
        it names the product, the category, the platforms, the price and the
        three differentiators without a single adjective.
      */}
      <p class="definition">{SITE.definition}</p>

      <StoreButtons size="large" />

      <ul class="trust">
        <li>Free to use</li>
        <li>No advertising</li>
        <li>Import from Letterboxd or IMDb</li>
      </ul>
    </div>

    {/*
      Each frame sits in a wrapper that Hero itself renders.

      This is not stylistic. Astro scopes a component's styles to the elements
      that component declares, so a class passed down as a prop lands on the
      child's root element with the CHILD's scope hash and the parent's rules
      never match it. That failed silently here: every rule positioning these
      two frames was dead, and both rendered as plain flex items, same size,
      no overlap, no gap. Styling a wrapper the parent owns is the fix.
    */}
    <div class="art">
      <div class="frame frame-back">
        <PhoneFrame
          src={libraryShot}
          alt="The I Like Movies library screen showing a grid of film posters sorted by IMDb rating, with watchlist, watched and collection counts"
          priority
        />
      </div>
      <div class="frame frame-front">
        {/* topInset off: this screen opens on a full-bleed backdrop still
            that is meant to run under the bezel's corners. A strip of flat
            background above it would read as a letterbox band. */}
        <PhoneFrame
          src={movieDetailShot}
          alt="The film detail screen in I Like Movies showing The Odyssey with its IMDb rating, director, runtime and watchlist controls"
          priority
          topInset={false}
        />
      </div>
    </div>
  </div>

  <a class="scroll-cue" href="#discover" aria-label="Scroll to features">
    <span aria-hidden="true"></span>
  </a>
</section>

<style>
  /*
    The hero fills the viewport rather than sitting at a fixed height, so it
    lands as one complete image on any screen.

    100svh, not 100vh: on mobile browsers vh is measured against the LARGEST
    viewport, the one with the address bar retracted, so 100vh overflows by
    the height of the bar and pushes the buttons under it on first paint.
    svh measures the smallest state and cannot do that.

    max() with a rem floor keeps it usable on a short landscape window, where
    a strict viewport height would crush the copy into nothing.
  */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: max(100svh, 40rem);
    padding: clamp(88px, 12vh, 132px) 0 clamp(72px, 10vh, 104px);
    /* Clips .glow's negative inset and the rotated frame-back/frame-front
       phone illustrations below, the only elements on the site that extend
       past their container. This is the page's one horizontal-overflow
       guard now that body no longer carries a blanket overflow-x: hidden;
       keep it if either of those is ever removed or re-laid-out. */
    overflow: hidden;
  }

  /* Brand spectrum bloom behind the copy. Radial gradients rather than an
     image, so it costs nothing and scales to any viewport. */
  .glow {
    position: absolute;
    inset: -25% -10% auto -10%;
    height: 900px;
    background:
      radial-gradient(52% 46% at 18% 24%, rgba(200, 55, 45, 0.32), transparent 70%),
      radial-gradient(46% 40% at 72% 12%, rgba(245, 197, 24, 0.24), transparent 72%),
      radial-gradient(60% 50% at 50% 0%, rgba(59, 130, 246, 0.18), transparent 75%);
    filter: blur(18px);
    pointer-events: none;
  }

  .grid {
    position: relative;
    display: grid;
    gap: clamp(40px, 6vw, 72px);
    align-items: center;
    width: 100%;
  }

  .copy {
    max-width: 640px;
  }

  .eyebrow {
    margin: 0 0 14px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .copy h1 {
    font-size: clamp(2.6rem, 7vw, 4.8rem);
  }

  .accent {
    background: linear-gradient(100deg, var(--gold), var(--ember) 55%, var(--crim));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* Kicker between the gradient H1 and the muted definition: brighter and
     heavier than the definition so it reads as the job line, narrower so it
     wraps to two lines under the large heading rather than running full
     width. */
  .job {
    margin: 18px 0 0;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    font-weight: 600;
    line-height: 1.3;
    color: var(--text);
    max-width: 44ch;
  }

  .definition {
    margin-top: 24px;
    margin-bottom: 32px;
    font-size: clamp(1.08rem, 1.7vw, 1.28rem);
    color: var(--text-secondary);
    max-width: 56ch;
  }

  .trust {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 26px;
    list-style: none;
    padding: 0;
    margin: 30px 0 0;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .trust li {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .trust li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
    flex: none;
  }

  /* Art -------------------------------------------------------------------- */

  .art {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .frame {
    width: min(300px, 72vw);
  }

  /* Below the breakpoint only one phone shows. Two overlapping frames on a
     narrow screen means each is too small to read. */
  .frame-back {
    display: none;
  }

  @media (min-width: 940px) {
    .art {
      justify-content: flex-end;
      padding-right: clamp(0px, 3vw, 48px);
      min-height: 620px;
      align-items: center;
    }

    .frame-front {
      position: relative;
      z-index: 2;
      width: clamp(300px, 25vw, 360px);
      transform: rotate(3deg);
      filter: drop-shadow(-24px 30px 50px rgba(0, 0, 0, 0.6));
    }

    /* The back frame is smaller, rotated further and pushed up and left, so
       the pair reads as depth rather than as two phones in a row. The offset
       is a percentage of the front frame so the gap holds as the clamp above
       resizes it. */
    .frame-back {
      display: block;
      position: absolute;
      z-index: 1;
      right: 46%;
      top: 50%;
      width: clamp(240px, 21vw, 292px);
      transform: translateY(-58%) rotate(-8deg);
      opacity: 0.85;
      filter: drop-shadow(-18px 24px 44px rgba(0, 0, 0, 0.55));
    }
  }

  /* Scroll cue ------------------------------------------------------------- */

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 26px;
    transform: translateX(-50%);
    width: 26px;
    height: 42px;
    border: 2px solid rgba(148, 163, 184, 0.45);
    border-radius: 999px;
    display: none;
  }

  .scroll-cue span {
    position: absolute;
    left: 50%;
    top: 9px;
    width: 4px;
    height: 8px;
    margin-left: -2px;
    border-radius: 2px;
    background: var(--gold);
    animation: cue 1.9s ease-in-out infinite;
  }

  @keyframes cue {
    0%,
    100% {
      transform: translateY(0);
      opacity: 1;
    }
    60% {
      transform: translateY(13px);
      opacity: 0.15;
    }
  }

  /* Only shown where the hero actually fills the screen. On a short window
     there is no "below the fold" to point at. */
  @media (min-height: 700px) and (min-width: 700px) {
    .scroll-cue {
      display: block;
    }
  }

  @media (min-width: 940px) {
    .grid {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }
</style>
