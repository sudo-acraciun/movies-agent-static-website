---
import { SITE } from '../data/site';
import Analytics from '../components/Analytics.astro';

interface Props {
  title: string;
  description: string;
  /** Path only, resolved against SITE.url for the canonical + og:url tags. */
  path?: string;
  /** Extra JSON-LD blocks, already shaped as schema.org objects. */
  jsonLd?: unknown[];
  /** Keeps utility pages (the /share redirector) out of search results. */
  noindex?: boolean;
}

const { title, description, path = '/', jsonLd = [], noindex = false } = Astro.props;
const canonical = new URL(path, SITE.url).href;
const ogImage = new URL('/og-image.png', SITE.url).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0A0D14" />

    {/*
      Open Graph and Twitter cards are not vanity tags here. Every share of
      this link happens inside WhatsApp, Discord, Reddit or a DM, and the
      unfurled preview IS the advert in those contexts. A missing og:image
      renders as a bare grey link.

      Comment syntax note, applies to every .astro file in this repo: HTML
      comments in markup are copied verbatim into the shipped page. Expression
      comments like this one are stripped at build time, so internal notes use
      this form and never <!-- -->.
    */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="I Like Movies. Everything you have watched. Everything you are going to."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* is:inline keeps Astro's script pipeline out of these. They are data
        blocks, not JavaScript, and bundling one would move the structured
        data out of the HTML a crawler reads. */}
    {
      jsonLd.map((block) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }

    <Analytics />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /*
    Design tokens mirrored from the mobile app's src/constants/brand.ts and
    src/constants/colors.ts. They are duplicated rather than imported because
    this is a separate repository with no build-time link to the app. If the
    app's palette changes, these move with it by hand.
  */
  :root {
    --ink: #0a0d14;
    --ink-raised: #141822;
    --ink-border: #252d3d;
    --card: #141822;

    --crim: #c8372d;
    --ember: #e8833a;
    --gold: #f5c518;
    --brand-white: #fff8e7;

    --primary: #3b82f6;
    --text: #ffffff;
    --text-secondary: #94a3b8;

    /* Was #64748b, which measured 3.7:1 on the cards and 4.1:1 on the page
       background. Every place it is used is small text (the hero trust list,
       the SWITCHING labels, the footer column headings, the copyright line)
       and none of it is large enough for the 3:1 allowance, so all of it was
       under the 4.5:1 that WCAG AA asks for body text.

       This lands at 5.1:1 on the cards and 5.6:1 on the footer while keeping
       a real tonal step below --text-secondary at 6.9:1, which is the whole
       point of having a third tier. It also lifts the FAQ chevron, a state
       indicator that has to clear 3:1 in its own right. */
    --text-muted: #7b8aa1;

    /* Sustained reading, currently the FAQ answers only.
       --text-secondary is tuned for short supporting lines and sits around
       5.9:1 against the card background, which is fine for a caption and
       tiring for four sentences. Pure white is the other extreme: at
       paragraph length it glares on a near-black background. This sits
       between them at roughly 11:1. */
    --text-body: #cbd5e1;

    --max-width: 1120px;
    --radius: 16px;
    --radius-lg: 24px;

    --font: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto,
      'Helvetica Neue', Arial, sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    /* Anchored sections must clear the sticky header or the heading lands
       underneath it when a nav link is followed. */
    scroll-padding-top: 88px;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  body {
    margin: 0;
    background: var(--ink);
    color: var(--text);
    font-family: var(--font);
    font-size: 17px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  h1,
  h2,
  h3 {
    line-height: 1.1;
    letter-spacing: -0.025em;
    margin: 0;
    font-weight: 800;
  }

  h1 {
    font-size: clamp(2.4rem, 6.5vw, 4.2rem);
  }

  h2 {
    font-size: clamp(1.9rem, 4.5vw, 3rem);
  }

  h3 {
    font-size: clamp(1.15rem, 2.2vw, 1.4rem);
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  p {
    margin: 0 0 1rem;
  }

  a {
    color: inherit;
  }

  img,
  svg {
    max-width: 100%;
    display: block;
  }

  .wrap {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 24px;
  }

  .section {
    padding: clamp(64px, 10vw, 120px) 0;
  }

  .lede {
    color: var(--text-secondary);
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
  }

  /* Keyboard focus must stay visible: the page is almost entirely links and
     the dark palette hides the browser default outline. */
  a:focus-visible,
  button:focus-visible,
  summary:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 3px;
    border-radius: 6px;
  }

  /*
    Content sections are Tab stops (see the note on tabindex in FeatureBlock),
    so they need an indicator like any other stop.

    Drawn as a pseudo-element ring rather than an outline, because the ring
    has to be ROUNDED and an outline cannot be rounded on its own: it follows
    the element's border-radius, and setting a radius on the section would
    round the section's real box. That matters for one of these: the
    capabilities band is full-bleed with its own background and top/bottom
    borders, so a radius would round a full-viewport-width band on focus and
    make it look like it had come loose from the page.

    A pseudo-element decouples the two. inset draws it inside the section
    edge, so it never overhangs the viewport horizontally or doubles up on a
    section's own border, and border-radius is free to match the rest of the
    site. border, not box-shadow: Windows High Contrast mode recolours a
    border and drops a box-shadow entirely.
  */
  main section[tabindex] {
    position: relative;
  }

  main section[tabindex]:focus-visible {
    outline: none;
  }

  main section[tabindex]:focus-visible::after {
    content: '';
    position: absolute;
    inset: 6px;
    border: 3px solid var(--gold);
    border-radius: var(--radius-lg);
    pointer-events: none;
  }

  /* main is a focus TARGET for the skip link, not a control. It is focusable
     so that following the link fires a real focus event and a screen reader
     announces the landmark; a ring here would outline the entire page. */
  #main:focus,
  #main:focus-visible {
    outline: none;
  }

  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--gold);
    color: var(--ink);
    padding: 12px 20px;
    font-weight: 700;
    z-index: 100;
  }

  .skip-link:focus {
    left: 12px;
    top: 12px;
  }
</style>
