---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Path only, forwarded to Layout for the canonical + og:url tags. */
  path: string;
  /** The visible H1. Separate from `title`, which carries the brand suffix. */
  heading: string;
  /** Effective date, copied verbatim from the published document. */
  updated: string;
}

const { title, description, path, heading, updated } = Astro.props;
---

<Layout title={title} description={description} path={path}>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header />
  <main id="main" tabindex="-1" class="legal">
    <div class="wrap">
      <h1>{heading}</h1>
      <p class="updated">I Like Movies · Last updated {updated}</p>
      <slot />
    </div>
  </main>
  <Footer />
</Layout>

<style is:global>
  /*
    is:global, not scoped. Astro scopes a component's styles to elements in
    that component's own template, and everything below the <slot> belongs to
    the page rendering it, so a scoped rule here would style the h1 and the
    date line and nothing else. Every selector is prefixed with .legal, which
    only this layout emits, so the practical reach is the same.
  */
  .legal {
    padding: clamp(48px, 7vw, 80px) 0 clamp(64px, 9vw, 96px);
  }

  .legal .wrap {
    max-width: 760px;
  }

  /* The global h1 clamp is sized for the hero. A document title is not a
     headline and reads as shouting at 4rem. */
  .legal h1 {
    font-size: clamp(2rem, 4vw, 2.6rem);
  }

  .legal .updated {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 10px 0 32px;
  }

  .legal h2 {
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 38px 0 10px;
  }

  /* --text-body, not --text-secondary: these are documents someone reads
     end to end, and the caption tier is tiring at that length. */
  .legal p,
  .legal li {
    color: var(--text-body);
  }

  .legal ul {
    padding-left: 22px;
    margin: 0 0 1rem;
  }

  .legal li {
    margin: 6px 0;
  }

  .legal a {
    color: var(--link);
    text-underline-offset: 3px;
  }

  /* The sub-processor table is the one piece of tabular data in here. It has
     to stay readable at 360px without forcing the page body to scroll
     sideways, hence the scroll container rather than a squeezed layout. */
  .legal .table-scroll {
    overflow-x: auto;
    margin: 0 0 1rem;
  }

  .legal table {
    width: 100%;
    min-width: 440px;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .legal th,
  .legal td {
    text-align: left;
    padding: 10px 12px;
    border-bottom: 1px solid var(--ink-border);
    vertical-align: top;
    color: var(--text-body);
  }

  .legal th {
    color: var(--text);
    font-weight: 700;
  }
</style>
