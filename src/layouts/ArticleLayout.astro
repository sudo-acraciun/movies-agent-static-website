---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { DISCLOSURE } from '../data/comparisons';
import { breadcrumbList, type Crumb } from '../data/schema';

interface Props {
  title: string;
  description: string;
  /** Path only, forwarded to Layout for the canonical + og:url tags. */
  path: string;
  /** The visible H1. Separate from `title`, which carries the brand suffix. */
  heading: string;
  /** Extra JSON-LD blocks, forwarded to Layout. */
  jsonLd?: unknown[];
  /**
   * Ordered breadcrumb trail (Home > Guides > this page). When passed, it
   * renders a visible breadcrumb nav above the H1 AND a BreadcrumbList JSON-LD
   * node, both from this one array so they cannot drift. The last crumb is the
   * current page and omits its href. Pages that pass nothing are unchanged.
   */
  breadcrumbs?: Crumb[];
  /**
   * Full-bleed backdrop rendered above the article, fading into the page
   * background. Decorative only (empty alt): the /themes pages pass the
   * featured film's TMDB backdrop, the same image the app's Discover tab
   * uses for the week.
   */
  heroImage?: string;
  /**
   * The developer-conflict disclosure is comparison-specific. Pages that make
   * no head-to-head claim (the changelog) pass false to suppress it, rather
   * than rendering a disclaimer for a claim they never make.
   */
  disclosure?: boolean;
}

const { title, description, path, heading, jsonLd = [], disclosure = true, heroImage, breadcrumbs } = Astro.props;

// One source feeds both the visible nav and the structured data: append the
// BreadcrumbList node only when a trail was passed, so other page types are
// untouched.
const allJsonLd = breadcrumbs && breadcrumbs.length ? [...jsonLd, breadcrumbList(breadcrumbs)] : jsonLd;
---

<Layout title={title} description={description} path={path} jsonLd={allJsonLd}>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header />
  {
    heroImage && (
      <div class="article-hero" aria-hidden="true">
        <img src={heroImage} alt="" loading="eager" fetchpriority="high" />
      </div>
    )
  }
  <main id="main" tabindex="-1" class="article">
    <div class="wrap">
      {
        breadcrumbs && breadcrumbs.length > 0 && (
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            {breadcrumbs.map((crumb, i) => (
              <span class="crumb">
                {i > 0 && <span class="sep" aria-hidden="true">/</span>}
                {crumb.href ? (
                  <a href={crumb.href}>{crumb.label}</a>
                ) : (
                  <span aria-current="page">{crumb.label}</span>
                )}
              </span>
            ))}
          </nav>
        )
      }
      <h1>{heading}</h1>
      {/* On comparison pages the developer-conflict disclosure sits before any
          claim, by construction: part of the layout, so a page cannot forget
          it. Suppressed where there is no such claim to disclose against. See
          the note on DISCLOSURE in comparisons.ts. */}
      {disclosure && <p class="disclosure">{DISCLOSURE}</p>}
      <slot />
    </div>
  </main>
  <Footer />
</Layout>

<style is:global>
  /*
    is:global with every selector prefixed .article, for the same reason
    LegalLayout does it: scoped styles cannot reach the page content that
    arrives through the <slot>.
  */
  .article {
    padding: clamp(48px, 7vw, 80px) 0 clamp(64px, 9vw, 96px);
  }

  /* Backdrop strip: the image fades into the page background so the heading
     below reads on solid --ink, never on the image itself. */
  .article-hero {
    position: relative;
    height: clamp(180px, 30vw, 340px);
    overflow: hidden;
  }

  .article-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(10, 13, 20, 0.35), rgba(10, 13, 20, 0.55) 60%, var(--ink));
  }

  /* With a hero above, the article's own top padding shrinks: the strip
     already provides the breathing room. */
  .article-hero + .article {
    padding-top: clamp(24px, 3.5vw, 40px);
  }

  .article .wrap {
    max-width: 760px;
  }

  /* The global h1 clamp is sized for the hero, not an article headline. */
  .article h1 {
    font-size: clamp(2rem, 4.5vw, 2.8rem);
  }

  /* Breadcrumb trail above the H1. Quiet by design: an orientation aid and an
     upward link to /guides, not a second navigation. */
  .article .breadcrumbs {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  /* Grey, not the blue prose --link: at 0.85rem a saturated blue trail reads
     cheap against the dark palette, and the breadcrumb is meant to be quiet. */
  .article .breadcrumbs a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  .article .breadcrumbs a:hover {
    color: var(--text);
    text-decoration: underline;
  }

  .article .breadcrumbs .sep {
    margin: 0 8px;
    color: var(--text-muted);
  }

  .article .breadcrumbs [aria-current='page'] {
    color: var(--text-muted);
  }

  .article .disclosure {
    color: var(--text-secondary);
    font-size: 0.95rem;
    border-left: 3px solid var(--gold);
    padding: 10px 16px;
    margin: 22px 0 34px;
    background: var(--ink-raised);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .article h2 {
    font-size: clamp(1.35rem, 2.6vw, 1.7rem);
    margin: 46px 0 14px;
  }

  .article h3 {
    margin: 26px 0 8px;
  }

  .article p,
  .article li {
    color: var(--text-body);
  }

  .article ul {
    padding-left: 22px;
    margin: 0 0 1rem;
  }

  .article li {
    margin: 6px 0;
  }

  .article a {
    color: var(--link);
    text-underline-offset: 3px;
  }

  /* Same scroll-container pattern as the legal sub-processor table: the
     feature table must survive 360px without the page scrolling sideways. */
  .article .table-scroll {
    overflow-x: auto;
    margin: 0 0 1rem;
  }

  .article table {
    width: 100%;
    min-width: 520px;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .article th,
  .article td {
    text-align: left;
    padding: 10px 12px;
    border-bottom: 1px solid var(--ink-border);
    vertical-align: top;
    color: var(--text-body);
  }

  .article th {
    color: var(--text);
    font-weight: 700;
  }

  /* FAQ styling mirrors the homepage FAQ: details/summary, no JS. */
  .article details {
    border-bottom: 1px solid var(--ink-border);
    padding: 4px 0;
  }

  /* Separate the final FAQ from whatever follows it (a "More reading" or
     "More comparisons" line on most page types) so that text does not crowd
     the divider above it. last-of-type, so gaps between FAQs are untouched. */
  .article details:last-of-type {
    margin-bottom: 28px;
  }

  .article summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--text);
    padding: 12px 0;
    list-style-position: outside;
  }

  .article .cta-row {
    margin: 40px 0 0;
    display: flex;
    /* Stacked, not side by side: the pill and a plain text link at equal
       visual rank on one line read as competing actions. Button first,
       quiet link underneath. */
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .article .cta-button {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    font-weight: 700;
    /* The page body's 1.65 line-height is for paragraphs; inherited into a
       pill button it inflates the text box and the label sits visibly off
       centre. 1.15 matches the store buttons. */
    line-height: 1.15;
    padding: 14px 24px;
    border-radius: 999px;
    color: var(--ink);
    background: linear-gradient(135deg, var(--gold), var(--ember));
  }

  /* The honest-warning panel: used for "there is no importer" and similar
     expectation-setting. Deliberately louder than body copy; its whole job
     is to be read before an install happens. */
  .article .plain-panel {
    border: 1px solid var(--ink-border);
    border-left: 3px solid var(--ember);
    background: var(--ink-raised);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: 14px 18px;
    margin: 0 0 1rem;
  }

  .article .plain-panel p {
    margin: 0;
  }
</style>
