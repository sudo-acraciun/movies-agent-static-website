---
import ArticleLayout from '../layouts/ArticleLayout.astro';
import { SITE } from '../data/site';
import { WATCH_ORDERS } from '../data/watchOrders';
import { COMPARISONS } from '../data/comparisons';
import { ROUNDUPS } from '../data/roundups';
import { LISTICLES } from '../data/listicles';
import { WEEKLY_THEMES, formatWeek } from '../data/themes';

// Themes rotate weekly, so the hub shows only the latest few and hands the
// rest to the /themes archive index; listing every week here forever would
// drown the evergreen sections.
const LATEST_THEMES = WEEKLY_THEMES.slice(0, 4);

// The hub. Every guide-type page on the site is reachable from here, and this
// page is the ONE the footer links, so a crawler entering anywhere reaches the
// whole network in two hops. The lists iterate the data modules directly: a
// new entry in watchOrders.ts or comparisons.ts appears here on the next
// build with no edit to this file.
//
// The standalone guides below have their copy in their own page frontmatter
// rather than a data module, so they are listed by hand. Any page type with a
// data module (watch orders, comparisons, listicles) is iterated instead.
const STANDALONE_GUIDES = [
  {
    path: '/from-tv-time',
    name: 'Life after TV Time',
    blurb:
      'TV Time closed in July 2026. Where the tracking habit goes next, including the apps that fit better than this one.',
  },
  {
    path: '/what-to-watch-together',
    name: 'How to decide what to watch together',
    blurb:
      'Ways for two people to pick a film without losing the evening. Most of them need no app at all.',
  },
];

const path = '/guides';
const title = 'Movie and TV guides: watch orders and honest app comparisons | I Like Movies';
const description =
  'Franchise watch orders kept up to date, app comparisons written by the developer that say where the other app is better, and practical help deciding what to watch.';

// One flat list of everything the page links, in page order, feeding the
// ItemList below so the structured data and the visible lists cannot drift.
const allEntries = [
  ...WATCH_ORDERS.map((w) => ({ path: `/${w.slug}`, name: `${w.franchise} watch order` })),
  ...LISTICLES.map((l) => ({ path: `/list/${l.slug}`, name: l.h1 })),
  ...LATEST_THEMES.map((t) => ({ path: `/themes/${t.slug}`, name: t.h1 })),
  { path: '/themes', name: 'Weekly themes archive' },
  ...ROUNDUPS.map((r) => ({ path: `/best/${r.slug}`, name: r.h1 })),
  ...COMPARISONS.map((c) => ({ path: `/vs/${c.slug}`, name: c.h1 })),
  ...STANDALONE_GUIDES.map((g) => ({ path: g.path, name: g.name })),
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Movie and TV guides',
    description,
    url: new URL(path, SITE.url).href,
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: allEntries.length,
      itemListElement: allEntries.map((entry, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: entry.name,
        url: new URL(entry.path, SITE.url).href,
      })),
    },
  },
];
---

<ArticleLayout
  title={title}
  description={description}
  path={path}
  heading="Movie and TV guides"
  jsonLd={jsonLd}
  disclosure={false}
>
  <p>
    Everything on this site that is not about the app itself lives here:
    franchise watch orders, ranked lists, comparisons with the other tracking
    apps, and practical guides for the evening's actual problem, which is
    deciding.
    All of it is written and kept current by the developer of I Like Movies,
    and the comparison pages say so before making any claim.
  </p>

  <h2>Franchise watch orders</h2>
  <p>
    Every film and series in a franchise, in the order to watch them, updated
    as new titles arrive.
  </p>
  <ul class="hub-list">
    {
      WATCH_ORDERS.map((w) => (
        <li>
          <a href={`/${w.slug}`}>{w.franchise} watch order</a>
          <p>{w.metaDescription}</p>
        </li>
      ))
    }
  </ul>

  <h2>Ranked lists and picks</h2>
  <p>
    Opinionated lists, each one stating plainly whose opinion it is.
  </p>
  <ul class="hub-list">
    {
      LISTICLES.map((l) => (
        <li>
          <a href={`/list/${l.slug}`}>{l.h1}</a>
          <p>{l.metaDescription}</p>
        </li>
      ))
    }
  </ul>

  <h2>Weekly themes</h2>
  <p>
    Every Friday the app's Discover tab gets a themed collection of 21
    hand-picked films. The latest weeks are below; the archive holds them all.
  </p>
  <ul class="hub-list">
    {
      LATEST_THEMES.map((t) => (
        <li>
          <a href={`/themes/${t.slug}`}>{t.h1}</a>
          <p>Week of {formatWeek(t.weekOf)}</p>
        </li>
      ))
    }
    <li>
      <a href="/themes">Weekly themes archive</a>
      <p>Every past collection, {WEEKLY_THEMES.length} weeks and counting, newest first.</p>
    </li>
  </ul>

  <h2>Best-app roundups</h2>
  <p>
    The apps worth knowing for a given job, ranked and compared. Written by the
    makers of one of them, so each page says so, includes a real comparison
    table, and credits every other app for what it does best.
  </p>
  <ul class="hub-list">
    {
      ROUNDUPS.map((r) => (
        <li>
          <a href={`/best/${r.slug}`}>{r.h1}</a>
          <p>{r.metaDescription}</p>
        </li>
      ))
    }
  </ul>

  <h2>App comparisons</h2>
  <p>
    Written by one side, so each page opens by saying so, names where the other
    app is the better choice, and scores nothing.
  </p>
  <ul class="hub-list">
    {
      COMPARISONS.map((c) => (
        <li>
          <a href={`/vs/${c.slug}`}>{c.h1}</a>
          <p>{c.metaDescription}</p>
        </li>
      ))
    }
  </ul>

  <h2>Practical guides</h2>
  <ul class="hub-list">
    {
      STANDALONE_GUIDES.map((g) => (
        <li>
          <a href={g.path}>{g.name}</a>
          <p>{g.blurb}</p>
        </li>
      ))
    }
  </ul>

  <div class="cta-row">
    <a class="cta-button" href={SITE.playUrl} target="_blank" rel="noopener">
      Get I Like Movies on Google Play
    </a>
    <a href="/">More about the app</a>
  </div>
</ArticleLayout>

<style is:global>
  /* Prefixed .article like the layout's own rules; only the hub renders a
     .hub-list. The cards mirror the homepage capabilities grid (same border,
     radius and hover treatment) so the two pages read as one system; the
     article wrap is 760px, so the matrix resolves to two columns here. */
  .article .hub-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
  }

  .article .hub-list li {
    /* position: relative anchors the stretched link below, which is what
       makes the WHOLE card the click target rather than just the title. */
    position: relative;
    border: 1px solid var(--ink-border);
    border-radius: var(--radius);
    background: var(--card);
    padding: 20px 22px;
    margin: 0;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .article .hub-list li:hover {
    border-color: rgba(245, 197, 24, 0.4);
    transform: translateY(-3px);
  }

  /* Card titles are gold like headings, not blue like prose links: the whole
     card is the click target, so the title reads as a heading, not a link. */
  .article .hub-list a {
    font-weight: 700;
    color: var(--gold);
    text-decoration: none;
  }

  /* Stretched link: the anchor's hit area expands to cover its card, so the
     card is clickable everywhere and the cursor says so. */
  .article .hub-list a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  .article .hub-list p {
    margin: 8px 0 0;
    font-size: 0.92rem;
    color: var(--text-secondary);
  }
</style>
