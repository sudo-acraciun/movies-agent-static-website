---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import FeatureBlock from '../components/FeatureBlock.astro';
import StoreButtons from '../components/StoreButtons.astro';
import Footer from '../components/Footer.astro';
import { SITE, FEATURES, CAPABILITIES, FAQS, MIGRATIONS } from '../data/site';

// Real captures live in src/assets so astro:assets can process them into AVIF,
// WebP and a srcset. They are attached here rather than in site.ts because a
// data module holding image imports would couple copy to assets; site.ts keeps
// the placeholder path until a real file exists for that screen.
import discoverShot from '../assets/screenshots/discover.png';
import assistantShot from '../assets/screenshots/assistant.png';
import householdShot from '../assets/screenshots/household.png';
import feedShot from '../assets/screenshots/feed.png';

// Keyed by Feature.id. There is no placeholder fallback: every id in FEATURES
// must have a matching entry here, or PhoneFrame's `src.width / src.height`
// runs against undefined and fails the build (Astro renders this page at
// build time, so that throw happens during `astro build`, not in a browser).
const SHOTS: Record<string, ImageMetadata> = {
  discover: discoverShot,
  assistant: assistantShot,
  household: householdShot,
  friends: feedShot,
};

// --- Structured data -------------------------------------------------------
//
// Three blocks, each doing a different job:
//
//   MobileApplication    tells a search engine this is an app, on which
//                        platforms, in which category, at what price. This is
//                        what produces an app-style result rather than a
//                        generic page result. MobileApplication rather than
//                        the broader SoftwareApplication because the product
//                        is a phone app and the subtype says so directly.
//   FAQPage              mirrors the visible FAQ exactly. Built from the same
//                        FAQS array as the rendered markup so the two cannot
//                        drift apart, which would be a structured-data
//                        violation rather than a cosmetic bug.
//   WebSite              names the entity and its publisher, which is what
//                        disambiguates a small brand from same-named things.
//
// aggregateRating is deliberately ABSENT. Google treats review markup with no
// corresponding real reviews as spam, and the app has no public rating yet.
// Add it only when the Play rating is real, and only with the real numbers.

// Every page that talks about this app as an entity, from this domain's point
// of view. sameAs is how a search engine learns that the Play listing, the
// directory pages and the social profiles all describe ONE thing, which is
// the corroboration a Knowledge Graph node is built from. Only pages we
// control or have verified live belong here: a dead or wrong URL teaches the
// engine the wrong entity, which is worse than teaching it nothing.
//
// The Play URL is the bare listing, not SITE.playUrl: the referrer parameter
// exists to attribute installs, and an identity claim should point at the
// canonical page, not a tracked variant of it.
const SAME_AS = [
  'https://play.google.com/store/apps/details?id=com.moviesagent.app',
  'https://theresanaiforthat.com/ai/i-like-movies/',
  'https://alternativeto.net/software/i-like-movies/',
  'https://www.saashub.com/ilikemovies-app',
  'https://x.com/ilikemoviesapp',
  'https://www.tiktok.com/@ilikemoviesapp',
];

const softwareLd = {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: SITE.name,
  applicationCategory: 'EntertainmentApplication',
  applicationSubCategory: 'Movie and TV discovery and tracking',
  operatingSystem: 'Android',
  url: SITE.url,
  downloadUrl: SITE.playUrl,
  installUrl: SITE.playUrl,
  description: SITE.definition,
  inLanguage: 'en',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
  },
  featureList: [
    'AI movie and TV recommendations generated from your own ratings',
    'AI chat assistant for recommendations in plain language',
    'Follow friends and compare taste',
    'Shared household watchlist and watched history',
    'Streaming availability by country',
    'TV episode level progress tracking',
    'Viewing statistics by genre and country of origin',
    'Import from Letterboxd and IMDb',
  ],
  author: {
    '@type': 'Person',
    name: 'Alexandru Craciun',
  },
  sameAs: SAME_AS,
};

// Answers are stored as paragraphs for readability and joined back into one
// string here. The joined text is word-for-word identical to what renders on
// screen, which is the requirement: structured data that does not match the
// visible page is a violation, not a shortcut.
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a.join('\n\n') },
  })),
};

const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.definition,
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    email: SITE.supportEmail,
    address: {
      '@type': 'PostalAddress',
      addressCountry: SITE.operatorCountry,
    },
    sameAs: SAME_AS,
  },
};
---

{/*
  Title notes, since it is the highest-weight string on the page.

  Keyword first, brand last. The brand has no search volume yet, so leading
  with it spends the most valuable position on a term nobody types. Once
  people search "I Like Movies" by name this is worth revisiting.

  "tracker" rather than only "tracking app": both are searched, the page said
  "tracking" six times and "tracker" zero, and the two do not match each other
  automatically. "Find what to watch" leads because discovery is the brand
  identity; "iOS" is absent because the app is Android-only until the App
  Store release.

  72 characters: Google cuts around 600px, so the brand tail may truncate.
  Acceptable while the brand has no search volume of its own.
*/}
<Layout
  title="Find what to watch: AI movie and TV tracker for Android | I Like Movies"
  description={SITE.metaDescription}
  path="/"
  jsonLd={[softwareLd, faqLd, siteLd]}
>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header />

  {/* tabindex="-1" keeps this out of the Tab order but makes it focusable,
      which is what the skip link above needs. Following a fragment only
      moves real focus if the target can hold it; without this, "Skip to
      content" scrolled the page and left focus on the link, so a screen
      reader announced nothing and the next Tab carried on through the
      header. Not in the Tab order, so nobody tabs onto it by accident. */}
  <main id="main" tabindex="-1">
    <Hero />

    {
      FEATURES.map((feature, index) => (
        <FeatureBlock
          feature={feature}
          screenshot={SHOTS[feature.id]}
          flipped={index % 2 === 1}
        />
      ))
    }

    {/* Capabilities. Deliberately keyword-dense in plain language, because
        long-tail queries like "movie tracker with episode tracking" only
        match if those exact words exist somewhere in the HTML. This grid
        also carries the tracking vocabulary that lost its own section when
        the page was shortened. */}
    <section
      class="section capabilities"
      id="capabilities"
      tabindex="0"
      aria-labelledby="capabilities-title"
    >
      <div class="wrap">
        <div class="head">
          {/* Was "Small things that decide whether an app sticks", which is
              a nice line that tells neither a reader nor a crawler what the
              section contains. */}
          <h2 id="capabilities-title">Everything else: tracking, lists, stats and imports.</h2>
        </div>

        <div class="cards">
          {
            CAPABILITIES.map((capability) => (
              <article class="card">
                <h3>{capability.title}</h3>
                <p>{capability.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    {/* Switching. Framed as migration help rather than a scorecard: the same
        competitor names carry the same comparative query match, which is the
        only search a new domain can realistically win, but the content is
        useful to the reader instead of combative. A hostile framing gets
        quoted by generative search just as readily as a helpful one. */}
    <section
      class="section switching"
      id="switch"
      tabindex="0"
      aria-labelledby="switch-title"
    >
      <div class="wrap">
        <div class="head">
          {/* Naming the three apps in the H2 rather than only in the H3s
              below is the single highest-value heading change on the page.
              Comparative queries are the only searches a new domain can
              realistically win, and this is the heading that matches them. */}
          <h2 id="switch-title">Switching from Letterboxd, IMDb, Trakt or TV Time?</h2>
          <p class="lede">
            Every movie tracker is built for a different job, and the good ones
            are genuinely good. Here is how your library moves across, and what
            changes once it gets here.
          </p>
        </div>

        <div class="rows">
          {
            MIGRATIONS.map((migration) => (
              <article class="row">
                <h3>{migration.name}</h3>
                <div class="row-body">
                  <div>
                    <span class="label">Bringing your history</span>
                    <p>{migration.move}</p>
                  </div>
                  <div>
                    <span class="label">What is different here</span>
                    <p>{migration.changes}</p>
                  </div>
                </div>
                {migration.compare && (
                  <p class="row-more">
                    <a href={migration.compare.href}>{migration.compare.label}</a>
                  </p>
                )}
              </article>
            ))
          }
        </div>
      </div>
    </section>

    {/* FAQ. The details element gives a native accordion with zero
        JavaScript, and the answer text stays in the HTML source whether or
        not it is open, so a crawler reads all of it. A JS accordion would
        hide it from the ones that do not execute scripts. */}
    <section class="section faq" id="faq" tabindex="0" aria-labelledby="faq-title">
      <div class="wrap narrow">
        <div class="head">
          <h2 id="faq-title">Frequently asked questions</h2>
        </div>

        <div class="faq-list">
          {
            FAQS.map((faq, index) => (
              <details open={index === 0}>
                <summary>
                  <h3>{faq.q}</h3>
                  <span class="chev" aria-hidden="true" />
                </summary>
                <div class="answer">
                  {faq.a.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    {/* The one section that had no id. It needs one now so its heading can
        name the region, and an anchorable closing call to action is worth
        having regardless. */}
    <section
      class="section final"
      id="get-the-app"
      tabindex="0"
      aria-labelledby="get-the-app-title"
    >
      <div class="wrap cta-card">
        <h2 id="get-the-app-title">Your next film is already on the list.</h2>
        <p class="lede">
          Free to download, free to use, and your library imports from
          Letterboxd or IMDb in a few taps.
        </p>
        <StoreButtons size="large" align="center" />
      </div>
    </section>

    {/* There's An AI For That verification badge.

        Deliberately NOT in the shared Header/Footer: TAAFT verifies the single
        page that carries this embed, and a shared component would place it on
        all six pages and let the crawler verify the wrong one. It lives here,
        inside <main> on the homepage only.

        Do not remove or hide it once verified: TAAFT re-checks for it and
        un-verifies the listing if it disappears, and hiding it breaks their
        terms. */}
    <section class="taaft-strip" aria-label="Verification">
      <div class="wrap">
        <a
          href="https://theresanaiforthat.com/ai/i-like-movies/?ref=featured&v=12297105"
          target="_blank"
          rel="nofollow noopener"
        >
          {/* Self-hosted copy of their badge image: hotlinking
              media.theresanaiforthat.com leaked visitor IP/referrer, which
              clashes with the site's cookieless posture. The anchor href is
              what verification checks and stays theirs. */}
          <img
            width="300"
            src="/taaft-badge.png"
            alt="Featured on There's An AI For That"
          />
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .head {
    max-width: 62ch;
    margin-bottom: clamp(36px, 5vw, 56px);
  }

  .narrow {
    max-width: 860px;
  }

  /* Capabilities ---------------------------------------------------------- */

  .capabilities {
    background:
      radial-gradient(70% 60% at 50% 0%, rgba(59, 130, 246, 0.09), transparent 70%),
      #0c1017;
    border-top: 1px solid var(--ink-border);
    border-bottom: 1px solid var(--ink-border);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
  }

  .card {
    background: var(--card);
    border: 1px solid var(--ink-border);
    border-radius: var(--radius);
    padding: 26px 24px;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .card:hover {
    border-color: rgba(245, 197, 24, 0.4);
    transform: translateY(-3px);
  }

  .card h3 {
    margin-bottom: 10px;
  }

  .card p {
    color: var(--text-secondary);
    margin: 0;
    font-size: 0.97rem;
  }

  /* Switching ------------------------------------------------------------- */

  .rows {
    display: grid;
    gap: 18px;
  }

  .row {
    border: 1px solid var(--ink-border);
    border-radius: var(--radius);
    padding: 28px 26px;
    background: linear-gradient(180deg, rgba(20, 24, 34, 0.9), rgba(12, 16, 23, 0.9));
  }

  .row h3 {
    margin-bottom: 18px;
    color: var(--gold);
  }

  .row-body {
    display: grid;
    gap: 22px;
  }

  .label {
    display: block;
    font-size: 0.74rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 8px;
    font-weight: 700;
  }

  .row-body p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.98rem;
  }

  /* Quiet text link, same register as the discover block's guide link: a
     deep link for the reader who wants the full page, not a second CTA. */
  .row-more {
    margin: 16px 0 0;
    font-size: 0.95rem;
  }

  .row-more a {
    color: var(--gold);
    text-underline-offset: 3px;
  }

  @media (min-width: 820px) {
    .row-body {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
    }
  }

  /* FAQ ------------------------------------------------------------------- */

  .faq-list {
    display: grid;
    gap: 12px;
  }

  details {
    border: 1px solid var(--ink-border);
    border-radius: var(--radius);
    background: var(--card);
    padding: 4px 24px;
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    cursor: pointer;
    padding: 18px 0;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /*
    The focus ring belongs to the whole card, not to the row inside it.

    details carries 24px of horizontal padding, so the summary is 48px
    narrower than the card it sits in and the global summary:focus-visible
    ring landed visibly inset on both sides. It read as a ring around some
    inner element rather than around the question you are on.

    :has() moves it out to the card, where the 16px radius is already
    defined. Written as an upgrade rather than a replacement on purpose: a
    browser without :has() support ignores both rules and keeps the global
    ring on the summary, which is narrow but still a visible indicator. A
    plain override would have left those browsers with no indicator at all,
    which is a worse bug than the one being fixed.
  */
  details:has(> summary:focus-visible) {
    outline: 3px solid var(--gold);
    outline-offset: 2px;
  }

  details:has(> summary:focus-visible) > summary:focus-visible {
    outline: none;
  }

  summary h3 {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0;
  }

  .chev {
    flex: none;
    width: 10px;
    height: 10px;
    border-right: 2px solid var(--text-muted);
    border-bottom: 2px solid var(--text-muted);
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform 0.2s ease;
  }

  details[open] .chev {
    transform: rotate(-135deg) translate(-3px, -3px);
  }

  .answer {
    padding-bottom: 4px;
  }

  /* One colour for the whole answer.
     An earlier version brightened the first paragraph to mark it as the
     standalone answer. On a real three-paragraph answer that reads as two
     tiers of importance inside a single reply, which is not what is meant
     and makes the rest look like a footnote. Structure is already carried by
     the paragraph break and by the first sentence being self-contained; it
     does not need a colour too. */
  .answer p {
    margin: 0 0 16px;
    color: var(--text-body);
    max-width: 70ch;
  }

  /* Final call to action -------------------------------------------------- */

  .cta-card {
    text-align: center;
  }

  .cta-card h2 {
    margin-bottom: 16px;
  }

  .cta-card .lede {
    max-width: 52ch;
    margin: 0 auto 32px;
  }

  /* Verification badge ---------------------------------------------------- */

  /* Quiet strip, not another call to action: a hairline above it separates it
     from the final CTA, and the modest padding keeps it from reading as a
     second footer. The image carries its own 300px intrinsic width; the global
     img rule caps it at the viewport on narrow screens. */
  .taaft-strip {
    padding: clamp(28px, 4vw, 40px) 0;
    border-top: 1px solid var(--ink-border);
    text-align: center;
  }

  .taaft-strip a {
    display: inline-block;
  }

  .taaft-strip img {
    margin: 0 auto;
    height: auto;
  }
</style>
