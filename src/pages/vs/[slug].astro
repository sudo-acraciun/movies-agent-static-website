---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { COMPARISONS, NOT_DO, SITE } from '../../data/comparisons';
import { organizationNode, organizationRef, appStubNode, appRef, webSiteRef } from '../../data/schema';

export function getStaticPaths() {
  return COMPARISONS.map((comparison) => ({
    params: { slug: comparison.slug },
    props: { comparison },
  }));
}

const { comparison: c } = Astro.props;
const path = `/vs/${c.slug}`;

// Article + FAQPage on the page's own content, plus the shared Organization and
// a compact MobileApplication node (same @id as the homepage's full node, so an
// engine merges them). Emitting the app entity here puts it directly on the
// pages that surface for non-brand comparison queries. author/publisher/about
// reference the shared entities by @id rather than minting anonymous nodes.
//
// Never Review or aggregateRating: the developer scoring his own product would
// be a lie a parser can read, and the disclosure at the top says as much.
// The BreadcrumbList is added by ArticleLayout from the breadcrumbs prop.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: c.h1,
    description: c.metaDescription,
    author: organizationRef,
    publisher: organizationRef,
    about: appRef,
    isPartOf: webSiteRef,
    mainEntityOfPage: new URL(path, SITE.url).href,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: c.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a.join(' ') },
    })),
  },
  organizationNode,
  appStubNode,
];

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Guides', href: '/guides' },
  { label: c.h1 },
];
---

<ArticleLayout
  title={c.title}
  description={c.metaDescription}
  path={path}
  heading={c.h1}
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
>
  {/* The exact non-brand query for these pages is "<competitor> alternative",
      not "vs" or "comparison", so the phrase leads the body in an H2. The
      balanced view follows immediately in the intro and the "where <competitor>
      is better" section, so the heading frames the page without overclaiming. */}
  <h2>I Like Movies as a {c.competitor} alternative</h2>
  {c.intro.map((paragraph) => <p>{paragraph}</p>)}

  <h2>Where {c.competitor} is better</h2>
  {
    c.betterThere.map((point) => (
      <>
        <h3>{point.title}</h3>
        <p>{point.body}</p>
      </>
    ))
  }

  <h2>What is different in I Like Movies</h2>
  {
    c.differences.map((point) => (
      <>
        <h3>{point.title}</h3>
        <p>{point.body}</p>
      </>
    ))
  }

  <h2>Feature by feature</h2>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th scope="col">Feature</th>
          <th scope="col">I Like Movies</th>
          <th scope="col">{c.competitor}</th>
        </tr>
      </thead>
      <tbody>
        {
          c.table.map((row) => (
            <tr>
              <th scope="row">{row.feature}</th>
              <td>{row.ilm}</td>
              <td>{row.other}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2>Moving your library</h2>
  {c.migration.map((paragraph) => <p>{paragraph}</p>)}

  <h2>What I Like Movies does not do</h2>
  <ul>
    {NOT_DO.map((item) => <li>{item}</li>)}
  </ul>

  <h2>The honest verdict</h2>
  {c.verdict.map((paragraph) => <p>{paragraph}</p>)}

  <h2>Questions people ask</h2>
  {
    c.faqs.map((faq) => (
      <details>
        <summary>{faq.q}</summary>
        {faq.a.map((paragraph) => <p>{paragraph}</p>)}
      </details>
    ))
  }

  {/* Same inline-join shape as WatchOrderPage's other-orders line: the comma
      lives inside the expression so Astro's sibling whitespace never renders
      as " , ". */}
  <p>
    More comparisons: {COMPARISONS.filter((other) => other.slug !== c.slug).map((other, i) => (
      <span>{i > 0 && ', '}<a href={`/vs/${other.slug}`}>{other.competitor}</a></span>
    ))}. Or browse <a href="/guides">every guide and watch order</a>.
  </p>

  <div class="cta-row">
    <a class="cta-button" href={SITE.playUrl} target="_blank" rel="noopener">
      Get I Like Movies on Google Play
    </a>
    <a href="/">More about the app</a>
  </div>
</ArticleLayout>
