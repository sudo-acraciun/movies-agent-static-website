---
import Layout from '../layouts/Layout.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { SITE } from '../data/site';

// Deep-link redirector for shared titles. The app's external-share message
// links here (/share?id=<tmdbId>&mediaType=<movie|tv>) so the URL messengers
// display carries the brand domain, and this page bounces the click into the
// app's custom scheme. The legacy movienight redirector stays live untouched:
// its URL is baked into share messages sent by older builds.
//
// noindex + the sitemap filter in astro.config.mjs keep this utility page out
// of search results; it exists only to be tapped from a chat message.
---

<Layout
  title={`Open in ${SITE.name}`}
  description="Open a shared movie or series in the I Like Movies app, or get the app on Google Play."
  path="/share"
  noindex
>
  <main class="share-wrap">
    <div class="card">
      <h1>{SITE.name}</h1>
      <p class="status">Opening the app…</p>
      <a class="open-btn" href="#" id="manualOpen">Tap to open the app</a>
      <noscript><p class="status">Enable JavaScript to open the app.</p></noscript>
      <p class="get-line">New here? The app is free.</p>
      <StoreButtons align="center" />
    </div>
  </main>

  {/* is:inline — this must run in the page, unbundled, exactly where it
      stands: it reads the query string and wires #manualOpen, which exists
      by this point in the document. Mechanism ported from the movie branch
      of the movienight redirector. */}
  <script is:inline>
    var params = new URLSearchParams(window.location.search);
    var target = null;
    if (params.has('id')) {
      // mediaType disambiguates same-id collisions across media types (TMDB
      // ids are namespaced by type: TV 1396 and movie 1396 are different
      // titles). The app's detail route defaults to 'movie' when the param
      // is absent, so ?id=-only links still resolve; it is only appended
      // when supplied.
      target = 'moviesagentapp://movies/' + encodeURIComponent(params.get('id'));
      var mediaType = params.get('mediaType');
      if (mediaType) {
        target += '?mediaType=' + encodeURIComponent(mediaType);
      }
    }
    var openBtn = document.getElementById('manualOpen');
    if (target) {
      // Auto-bounce into the app; the anchor stays as the manual fallback
      // because some in-app webviews block scheme redirects issued from
      // window.location but honour a user-tapped link.
      openBtn.href = target;
      window.location.replace(target);
    } else {
      // No id in the URL: nothing to open, so only the store buttons make
      // sense. Hidden via script rather than markup so the noscript path
      // keeps its explanatory line instead of a dead button.
      openBtn.style.display = 'none';
    }
  </script>
</Layout>

<style>
  .share-wrap {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    text-align: center;
  }

  .card {
    max-width: 420px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  /* The global h1 clamp is hero-sized; this is a utility card, not a hero. */
  .card h1 {
    font-size: 1.6rem;
    letter-spacing: -0.015em;
  }

  .status {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin: 0;
  }

  .open-btn {
    display: inline-block;
    background: var(--primary);
    color: #fff;
    text-decoration: none;
    padding: 12px 24px;
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .open-btn:active {
    opacity: 0.85;
  }

  .get-line {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin: 10px 0 0;
  }
</style>
