---
import ArticleLayout from '../layouts/ArticleLayout.astro';
import { SITE } from '../data/site';
import shotLibrary from '../assets/screenshots/library.png';
import shotDiscover from '../assets/screenshots/discover.png';
import shotAssistant from '../assets/screenshots/assistant.png';
import shotDetail from '../assets/screenshots/movie-detail.png';
import shotFeed from '../assets/screenshots/feed.png';
import shotHousehold from '../assets/screenshots/household.png';

// Press page: one URL a journalist or a newsletter writer can open and have
// everything (facts, assets, bio, contact) without a reply from us. Written
// for the recommender-column pitches; the facts here must stay identical to
// the store listings and the FAQ, so most of them come from SITE.
//
// Coverage is links only. Quoting a writer's words back on our own site
// needs their permission; a link to their public article does not.
const path = '/press';
const title = 'Press kit';
const description =
  'Facts, screenshots, icon and maker bio for I Like Movies, the free movie and TV tracker for Android with an iPhone version in review.';
const mailto = `mailto:${SITE.supportEmail}`;

// Rendered from data, not hand-written rows: an <a href={x}>{y}</a> written
// directly as the sole content of a <td> made the Astro compiler emit a
// stray unclosed copy of that anchor after </table>, which turned the three
// sections below into one link. The same anchor produced from a .map()
// (as the Coverage list is) compiles cleanly.
const facts: { label: string; value: string; href?: string; external?: boolean }[] = [
  { label: 'Name', value: SITE.name },
  { label: 'What it is', value: 'A free movie and TV tracker that helps you decide what to watch' },
  { label: 'Platforms', value: 'Android on Google Play. iPhone version with Apple for review.' },
  { label: 'Price', value: 'Free. No advertising, no sponsored placements.' },
  { label: 'Launched', value: '12 August 2026 on Google Play' },
  { label: 'Made by', value: `Alexandru Crăciun, one developer, ${SITE.operatorCountry}` },
  { label: 'Website', value: SITE.domain, href: SITE.url },
  { label: 'Google Play', value: 'play.google.com', href: SITE.playUrl, external: true },
  { label: 'Package name', value: 'com.moviesagent.app' },
  { label: 'Contact', value: SITE.supportEmail, href: mailto },
];

const screenshots = [
  { name: 'Library', img: shotLibrary },
  { name: 'Discover', img: shotDiscover },
  { name: 'Assistant', img: shotAssistant },
  { name: 'Title page', img: shotDetail },
  { name: 'Friends feed', img: shotFeed },
  { name: 'Household', img: shotHousehold },
];

const coverage = [
  {
    outlet: 'Rich on Tech',
    piece: 'newsletter, 22 August 2026',
    url: 'https://richontech.tv/p/the-best-way-to-stop-a-scam-is-to',
  },
  {
    outlet: 'Bug.hr',
    piece: 'App dana, 26 August 2026',
    url: 'https://www.bug.hr/appdana/i-like-movies-osobni-mobilni-filmski-dnevnik-s-prilagodjenim-preporukama-62291',
  },
];
---

<ArticleLayout
  title={`${title} | ${SITE.name}`}
  description={description}
  path={path}
  heading="Press kit"
  disclosure={false}
>
  <p>
    Everything on this page may be used without asking. For anything else, or for a quick answer,
    write to <a href={mailto}>{SITE.supportEmail}</a>.
  </p>

  <h2>Factsheet</h2>
  <div class="table-scroll">
    <table>
      <tbody>
        {
          facts.map((f) => (
            <tr>
              <th>{f.label}</th>
              <td>
                {f.href ? (
                  <a href={f.href} target={f.external ? '_blank' : undefined} rel={f.external ? 'noopener' : undefined}>
                    {f.value}
                  </a>
                ) : (
                  f.value
                )}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <hr />
  <h2>In one sentence</h2>
  <p>{SITE.definition}</p>

  <hr />
  <h2>In a paragraph</h2>
  <p>
    I Like Movies is an independent app built by one developer in the Netherlands. It keeps a
    record of every film and series you have seen, with ratings, notes and episode progress, and
    then uses that record to help you pick the next one: monthly collections built from your own
    ratings, an assistant you can ask in plain language, and streaming availability resolved for
    your country. People who live together can share one library, and friends can follow what each
    other is watching. Letterboxd and IMDb exports import directly. It is free, carries no
    advertising, and shows no sponsored recommendations.
  </p>

  <hr />
  <h2>Maker</h2>
  <div class="maker">
    <img
      src="/press/alexandru-craciun.jpg"
      width="400"
      height="400"
      alt="Alexandru Crăciun"
      loading="lazy"
    />
    <p>
      Full-stack developer in the Netherlands, over ten years in. I Like Movies is my solo project,
      built because picking something to watch with someone else is harder than picking alone. It
      answers in plain words from your own ratings, your library and the streaming services you
      actually pay for.
    </p>
  </div>

  <hr />
  <h2>Assets</h2>
  <ul>
    <li><a href="/icon-512.png" download="ilikemovies-icon-512.png">App icon, 512 x 512 PNG</a></li>
    <li><a href="/press/alexandru-craciun.jpg" download>Maker photo, Alexandru Crăciun, 400 x 400 JPEG</a></li>
    {
      screenshots.map((s) => (
        <li>
          <a href={s.img.src} download>{s.name} screenshot, {s.img.width} x {s.img.height} PNG</a>
        </li>
      ))
    }
  </ul>
  <div class="shots" aria-label="Screenshots">
    {screenshots.map((s) => <img src={s.img.src} width={s.img.width} height={s.img.height} alt={`${s.name} screen of the app`} loading="lazy" />)}
  </div>
  <p>
    The zip holds the app icon, the maker photo, the six screenshots and the factsheet as plain
    text.
  </p>
  <p>
    <a class="cta-button" href="/press/ilikemovies-press-kit.zip" download>Download the press kit (zip)</a>
  </p>

  <hr />
  <h2>Coverage</h2>
  <ul>
    {
      coverage.map((c) => (
        <li>
          <a href={c.url} target="_blank" rel="noopener">{c.outlet}</a>, {c.piece}
        </li>
      ))
    }
  </ul>

  <hr />
  <h2>Facts you can check</h2>
  <ul>
    <li>Free, no ads, no in-app purchases at the time of writing.</li>
    <li>No account data is sold; the <a href="/privacy">privacy policy</a> lists every processor.</li>
    <li>Film and TV metadata comes from TMDB. The app uses the TMDB API but is not endorsed or certified by TMDB.</li>
    <li>Operated from the Netherlands under EU data-protection law.</li>
    <li>Changes ship most weeks; the <a href="/changelog">changelog</a> lists them.</li>
  </ul>
</ArticleLayout>

<style>
  /* Section dividers. Seven sections of mixed shape (table, prose, a photo,
     a grid) ran together; a rule between them gives the eye a place to
     stop. The heading keeps most of its top margin above the rule and
     takes a shorter one below it. */
  hr {
    border: 0;
    border-top: 1px solid var(--ink-border);
    margin: 44px 0 0;
  }

  hr + h2 {
    margin-top: 26px;
  }

  /* The photo's hard edge sits closer to the heading than a line of text
     does, so it gets a little extra air. */
  .maker {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    margin-top: 22px;
  }

  .maker img {
    width: 112px;
    height: 112px;
    flex: none;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--ink-border);
  }

  .maker p {
    margin: 0;
  }

  @media (max-width: 480px) {
    .maker {
      flex-direction: column;
    }
  }

  .shots {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 12px;
    margin: 0 0 2rem;
  }

  .shots img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--ink-border);
  }

  th {
    text-align: left;
    white-space: nowrap;
  }
</style>
