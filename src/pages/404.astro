---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { SITE } from '../data/site';

// Astro's `file` build format emits this at dist/404.html, and GitHub Pages
// serves that file for any unmatched path on the site with no extra config,
// so this component IS the site's 404 handler. Before this existed, a bad
// URL fell through to GitHub's own branded error page with no way back to
// the site. That matters more now that /share carries real deep-link traffic
// from shared-title messages: GitHub Pages routing is case-sensitive, so a
// mis-cased link (/Share, a stale movienight-era link, anything mistyped)
// lands here.
//
// noindex: a 404 must never be indexed. @astrojs/sitemap already excludes
// files literally named 404 and 500 (STATUS_CODE_PAGES in its source), so no
// change was needed in astro.config.mjs, but the meta tag is the page's own
// guarantee and does not depend on that staying true.
//
// No <Header /> / <Footer /> here, deliberately, same call /share already
// made. Both carry "#discover" / "#switch" / "#faq" nav links that only
// resolve on the homepage, where those section ids exist; reusing them as-is
// here would ship three dead links on the one page whose whole job is
// recovering from a broken link. The brand mark below is Header's own
// `.brand` link, copied without the nav that comes attached to it.
---

<Layout
  title={`Page not found | ${SITE.name}`}
  description="This page doesn't exist. Head back to the I Like Movies homepage or get the app on Google Play."
  path="/404"
  noindex
>
  <main class="not-found">
    <div class="card">
      <a class="brand" href="/" aria-label={`${SITE.name} home`}>
        <Logo size={34} />
        <span>I Like Movies</span>
      </a>

      <p class="code" aria-hidden="true">404</p>
      <h1>This page doesn't exist.</h1>
      <p class="lede">
        The link may be broken or the page may have moved. Head back to the
        homepage, or get the app if you are new here.
      </p>
      <a class="home-btn" href="/">Back to home</a>
      <p class="get-line">New here? The app is free.</p>
      <StoreButtons align="center" />
    </div>
  </main>
</Layout>

<style>
  /* Same centered-card shape as /share's utility card, since both are
     one-purpose pages rather than scrolling content. */
  .not-found {
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 24px;
    text-align: center;
  }

  .card {
    max-width: 420px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  /* Header's own .brand styling, reproduced here since the component itself
     is not reused (see the note above on why). */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text);
    font-weight: 800;
    letter-spacing: -0.02em;
    font-size: 1.05rem;
    margin-bottom: 8px;
  }

  .code {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--text-muted);
  }

  /* The global h1 clamp is hero-sized; this is a utility card, not a hero. */
  .card h1 {
    font-size: 1.6rem;
    letter-spacing: -0.015em;
  }

  .lede {
    margin: 0;
  }

  .home-btn {
    display: inline-block;
    background: var(--primary);
    color: #fff;
    text-decoration: none;
    padding: 12px 24px;
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .home-btn:active {
    opacity: 0.85;
  }

  .get-line {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin: 10px 0 0;
  }
</style>
